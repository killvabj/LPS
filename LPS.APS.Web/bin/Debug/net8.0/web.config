<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!--
      2026-10-30 上线实测：此前这里有一行 <httpEncoding encoding="UTF-8" />，
      它不是 system.webServer 的合法元素，IIS 读到即整份 web.config 解析失败，
      站点返回 500.19 / 子状态 13 / win32 0x8007000D，应用进程根本没被拉起、logs 也不生成。
      同时移除了全局 Content-Type 自定义响应头（会让所有响应多挂一个 Content-Type，
      静态文件与二进制下载一律被标成 application/json）。
      本地 IIS Express / VS 调试不校验这些元素，所以开发期一直没暴露。
    -->
    <!--
      环境开关（只对 IIS / IIS Express 托管生效）：上线后据此读 appsettings.Production.json。
      · VS 用 launchSettings 的 http / https profile 调试，不经过这里，仍是 Development。
      · processPath / arguments / hostingModel 由 Web SDK 在 dotnet publish 时自动补齐，此处不写死。
      · 写在本文件而不是发布目录，是为了每次重新发布都不会被覆盖掉。
    -->
    <aspNetCore>
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
      </environmentVariables>
    </aspNetCore>
  </system.webServer>
</configuration>
