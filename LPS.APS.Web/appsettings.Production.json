{
  "Application": {
    "Environment": "Production",
    "Cors": {
      "AllowedOrigins": [ "http://10.116.2.75:8080", "http://10.116.2.75" ],
      "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
      "AllowedHeaders": [ "*" ],
      "AllowCredentials": true
    }
  },
  "Database": {
    "APS": {
      "ConnectionString": "Server=10.116.2.75;Database=APS_Production;User Id=sa;Password=YOUR_DB_PASSWORD;TrustServerCertificate=true;",
      "Provider": "SqlServer",
      "CommandTimeout": 60,
      "ConnectionTimeout": 15,
      "MaxPoolSize": 100,
      "MinPoolSize": 5,
      "Pooling": true,
      "ReadOnly": false
    },
    "ODS": {
      "ConnectionString": "Server=10.116.2.73;Database=MES_Integration;User Id=sa;Password=YOUR_DB_PASSWORD;TrustServerCertificate=true;",
      "Provider": "SqlServer",
      "CommandTimeout": 120,
      "ConnectionTimeout": 15,
      "MaxPoolSize": 50,
      "MinPoolSize": 2,
      "Pooling": true,
      "ReadOnly": false
    },
    "Auth": {
      "ConnectionString": "Server=10.116.2.75;Database=APS_Auth;User Id=sa;Password=YOUR_DB_PASSWORD;TrustServerCertificate=true;",
      "Provider": "SqlServer",
      "CommandTimeout": 30,
      "ConnectionTimeout": 15,
      "MaxPoolSize": 50,
      "MinPoolSize": 2,
      "Pooling": true,
      "ReadOnly": false
    },
    "Hangfire": {
      "ConnectionString": "Server=10.116.2.75;Database=APS_Hangfire;User Id=sa;Password=YOUR_DB_PASSWORD;TrustServerCertificate=true;",
      "Provider": "SqlServer"
    },
    "EnableRetry": true,
    "MaxRetryCount": 3,
    "RetryDelay": 1000
  },
  "Jwt": {
    "SecretKey": "REPLACE_WITH_YOUR_PRODUCTION_SECRET_KEY_MIN_32_BYTES",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 3
  },
  "Snapshot": {
    "StoragePath": "D:\\HDD\\APS_Snapshots"
  },
  "Redis": {
    "ConnectionString": "prod-redis-cluster:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "LPS.APS": "Information",
      "LPS.APS.Engine.Services.Sync": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Warning"
    },
    "Console": {
      "IncludeScopes": false
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "LPS.APS": "Information",
        "LPS.APS.Engine": "Information",
        "LPS.APS.Engine.Services.Sync": "Information",
        "LPS.APS.Application": "Warning",
        "Microsoft": "Warning",
        "Hangfire": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "logs/warn/aps-warn-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "restrictedToMinimumLevel": "Warning",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} WARN] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/error/aps-error-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "restrictedToMinimumLevel": "Error",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff} ERROR] [{SourceContext}] {Message:lj}{NewLine}{Exception}{NewLine}----------------------------------------{NewLine}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/info/aps-info-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 104857600,
          "rollOnFileSizeLimit": true,
          "restrictedToMinimumLevel": "Information",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff}] [{SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Hangfire": {
    "WorkerCount": 16,
    "CronEnabled": false
  },
  "Api": {
    "RateLimit": {
      "Enabled": true,
      "PermitLimit": 1000
    }
  },
  "Business": {
    "Scheduling": {
      "MaxJobsPerSchedule": 5000,
      "Parallelism": 8
    }
  }
}
