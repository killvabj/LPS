<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <httpEncoding encoding="UTF-8" />
    <httpProtocol>
      <customHeaders>
        <add name="Content-Type" value="application/json; charset=utf-8" />
      </customHeaders>
    </httpProtocol>
    <!--
      环境开关（只对 IIS / IIS Express 托管生效）：上线后据此读 appsettings.Production.json。
      · VS 用 launchSettings 的 http / https profile 调试，不经过这里，仍是 Development。
      · processPath / arguments / hostingModel 由 Web SDK 在 dotnet publish 时自动补齐，此处不写死。
      · 写在本文件而不是发布目录，是为了每次重新发布都不会被覆盖掉。
    -->
    <aspNetCore>
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
      </environmentVariables>
    </aspNetCore>
  </system.webServer>
</configuration>
